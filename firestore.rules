rules_version = '2';

// ================================================================
//  RistoApp - Firestore Security Rules  (v5.3.0)
//  Da incollare in: Console Firebase > Firestore Database > Regole
//  (istruzioni in SETUP-FIREBASE.md). Vanno RI-INCOLLATE a ogni
//  versione che le modifica.
//
//  Collezioni:
//   restaurants/{id}  annunci dei titolari (lettura pubblica solo se hidden == false)
//   cin/{CIN}         un CIN = un solo annuncio
//   reports/{id}      segnalazioni (chiunque crea; solo l'amministratore legge)
//   appeals/{id}      contestazioni del titolare di un annuncio nascosto
//   cinClaims/{id}    richieste di liberare un CIN usato da altri
//   osmHidden/{id}    luoghi OpenStreetMap nascosti dopo moderazione (lettura pubblica)
//   users/{uid}       accettazione di informativa e condizioni d'uso
//   meta/{doc}        stato dello script di verifica (solo firebase-admin)
//  Lo script scripts/verify-owners.mjs usa firebase-admin, che ignora
//  queste regole.
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identita' ----------
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pezzalialessandro@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function emailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // ---------- Tipi di annuncio ----------
    function lodgingTypes() {
      return ['B&B', 'Agriturismo', 'Affittacamere', 'Casa vacanze', 'Hotel', 'Ostello'];
    }
    function foodTypes() {
      return ['Pizzeria', 'Trattoria', 'Osteria', 'Ristorante', 'Fast food', 'Bar', 'Caffè', 'Gelateria', 'Pub'];
    }
    // IT + 3 cifre provincia ISTAT + 3 cifre comune ISTAT
    // + 2 caratteri classificazione + da 1 a 8 caratteri
    function validCin(c) {
      return c is string && c.matches('^IT[0-9]{6}[A-Z0-9]{2}[A-Z0-9]{1,8}$');
    }
    function cinPath(c) {
      return /databases/$(database)/documents/cin/$(c);
    }

    // ---------- Campi ----------
    // Campi scritti SOLO dal server (script) o dall'amministratore
    function serverFields() {
      return ['verified', 'verifiedMethod', 'verifiedAt', 'verifiedFor', 'verifiedSnapshot',
              'hidden', 'hiddenReason', 'hiddenNote', 'moderatedAt', 'lastRecheck', 'reportsCount'];
    }
    function allowedFields() {
      return ['name', 'type', 'address', 'phone', 'website', 'lat', 'lng', 'hours',
              'payments', 'features', 'menu', 'owner', 'createdAt', 'updatedAt',
              'declarationAt', 'cin', 'directDiscount', 'whatsapp', 'contactEmail',
              'verifyRequestedAt'].concat(serverFields());
    }
    // Se cambiano, la verifica decade (verified deve tornare false)
    function identityFields() {
      return ['name', 'website', 'phone', 'whatsapp', 'contactEmail', 'cin', 'address'];
    }

    // stringa facoltativa con lunghezza massima
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }
    // telefono / WhatsApp: solo cifre, spazi e + ( ) . / -
    function optPhone(d, k) {
      return !(k in d) || (d[k] is string && d[k].size() <= 40 && d[k].matches('^[+0-9 ()./-]*$'));
    }
    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }
    // una fascia oraria "HH:MM-HH:MM"
    function okRange(r) {
      return r is string && r.matches('^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$');
    }
    // un giorno: lista di al massimo 4 fasce valide
    function okDay(h, k) {
      return !(k in h) || (h[k] is list && h[k].size() <= 4
        && (h[k].size() < 1 || okRange(h[k][0]))
        && (h[k].size() < 2 || okRange(h[k][1]))
        && (h[k].size() < 3 || okRange(h[k][2]))
        && (h[k].size() < 4 || okRange(h[k][3])));
    }
    function okHours(d) {
      return !('hours' in d) || (d.hours is map
        && d.hours.keys().hasOnly(['0', '1', '2', '3', '4', '5', '6'])
        && okDay(d.hours, '0') && okDay(d.hours, '1') && okDay(d.hours, '2')
        && okDay(d.hours, '3') && okDay(d.hours, '4') && okDay(d.hours, '5')
        && okDay(d.hours, '6'));
    }
    // sito: vuoto oppure http(s) senza spazi, virgolette o < >
    function okWebsite(d) {
      return !('website' in d) || (d.website is string && d.website.size() <= 300
        && (d.website == '' || d.website.matches('^https?://[!#-;=?-~]+$')));
    }
    function okEmail(d) {
      return !('contactEmail' in d) || (d.contactEmail is string && d.contactEmail.size() <= 200
        && (d.contactEmail == '' || d.contactEmail.matches('^[^@ ]+@[^@ ]+[.][A-Za-z]{2,}$')));
    }

    // Controlli comuni a creazione e modifica del titolare
    function validListing(d) {
      return d.keys().hasOnly(allowedFields())
        && d.keys().hasAll(['name', 'type', 'lat', 'lng', 'owner'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.type is string && (d.type in foodTypes() || d.type in lodgingTypes())
        // posizione dentro l'Italia (rettangolo approssimato)
        && d.lat is number && d.lat >= 35.2 && d.lat <= 47.2
        && d.lng is number && d.lng >= 6.5 && d.lng <= 18.7
        && optStr(d, 'address', 300)
        && optPhone(d, 'phone')
        && optPhone(d, 'whatsapp')
        && okWebsite(d)
        && okEmail(d)
        && okHours(d)
        && optList(d, 'menu', 200)
        && optList(d, 'features', 30)
        && optList(d, 'payments', 12)
        && (!('directDiscount' in d) || (d.directDiscount is int
              && d.directDiscount >= 0 && d.directDiscount <= 30))
        // il CIN esiste solo per le strutture ricettive
        && (!('cin' in d) || (d.type in lodgingTypes() && validCin(d.cin)))
        && (!('hidden' in d) || d.hidden is bool)
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('verifyRequestedAt' in d) || d.verifyRequestedAt is timestamp);
    }

    // Alloggi: email confermata + CIN valido, riservato a questo annuncio
    // (il doc cin/{CIN} va scritto nello stesso batch, vedi js/store.js)
    function validLodging(d, restaurantId) {
      return !(d.type in lodgingTypes())
        || (emailVerified()
            && validCin(d.cin)
            && getAfter(cinPath(d.cin)).data.owner == request.auth.uid
            && getAfter(cinPath(d.cin)).data.restaurant == restaurantId);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // verified: il titolare puo' solo toglierlo (true -> false). Se cambia
    // un campo d'identita' deve toglierlo: la verifica va ripetuta.
    function verifiedOk() {
      return (!changed().hasAny(identityFields())
              || request.resource.data.get('verified', false) == false)
        && (request.resource.data.get('verified', false) == resource.data.get('verified', false)
            || request.resource.data.get('verified', false) == false);
    }
    // Modifica del contenuto da parte del titolare
    function ownerEdit(restaurantId) {
      return validListing(request.resource.data)
        && request.resource.data.declarationAt == request.time
        && request.resource.data.updatedAt == request.time
        && validLodging(request.resource.data, restaurantId)
        // il CIN, una volta impostato, non cambia piu'
        && (!('cin' in resource.data) || request.resource.data.get('cin', '') == resource.data.cin)
        // data di creazione invariata
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        // hidden: resta com'e' (si puo' solo aggiungere a false sui dati vecchi)
        && ((('hidden' in resource.data) && request.resource.data.get('hidden', null) == resource.data.hidden)
            || (!('hidden' in resource.data) && request.resource.data.get('hidden', false) == false))
        // campi del server invariati (tranne verified, vedi verifiedOk e hidden sopra;
        // reportsCount, dato vecchio, si puo' solo cancellare)
        && !changed().hasAny(['verifiedMethod', 'verifiedAt', 'verifiedFor', 'verifiedSnapshot',
                              'hiddenReason', 'hiddenNote', 'moderatedAt', 'lastRecheck'])
        && (!changed().hasAny(['reportsCount']) || !('reportsCount' in request.resource.data))
        && verifiedOk();
    }
    // "Ho pubblicato il codice": chiede un nuovo controllo del sito
    function ownerTouch() {
      return changed().hasOnly(['verifyRequestedAt', 'updatedAt'])
        && request.resource.data.verifyRequestedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    // Moderazione: l'amministratore cambia SOLO la visibilita' e la motivazione
    function adminModeration() {
      return changed().hasOnly(['hidden', 'hiddenReason', 'hiddenNote', 'moderatedAt'])
        && request.resource.data.hidden is bool
        && request.resource.data.moderatedAt == request.time
        && (request.resource.data.hidden == false
            || (request.resource.data.get('hiddenReason', '') in ['moderation', 'cin_claim']
                && request.resource.data.get('hiddenNote', '') is string
                && request.resource.data.get('hiddenNote', '').size() > 0
                && request.resource.data.get('hiddenNote', '').size() <= 1000));
    }

    // ---------- Annunci ----------
    match /restaurants/{restaurantId} {
      // Pubblico: solo gli annunci visibili (la query deve contenere
      // where('hidden', '==', false)). Il titolare vede sempre i propri,
      // l'amministratore tutti.
      allow read: if resource.data.hidden == false
        || (signedIn() && resource.data.owner == request.auth.uid)
        || isAdmin();

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && validListing(request.resource.data)
        && request.resource.data.hidden == false
        && request.resource.data.declarationAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == request.time
        && validLodging(request.resource.data, restaurantId)
        && request.resource.data.get('verified', false) == false
        && !request.resource.data.keys().hasAny(['verifiedMethod', 'verifiedAt', 'verifiedFor',
              'verifiedSnapshot', 'hiddenReason', 'hiddenNote', 'moderatedAt', 'lastRecheck',
              'reportsCount', 'verifyRequestedAt']);

      allow update: if (signedIn()
          && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid
          && (ownerEdit(restaurantId) || ownerTouch()))
        || (isAdmin() && adminModeration());

      // Elimina il titolare (se c'e' un CIN, il suo doc va eliminato nello
      // stesso batch, cosi' il CIN si libera) oppure l'amministratore.
      allow delete: if (signedIn()
          && resource.data.owner == request.auth.uid
          && (!('cin' in resource.data) || !existsAfter(cinPath(resource.data.cin))))
        || isAdmin();
    }

    // ---------- CIN: un codice = un solo annuncio ----------
    match /cin/{cin} {
      allow read: if true;

      allow create: if emailVerified()
        && cin.matches('^IT[0-9]{6}[A-Z0-9]{2}[A-Z0-9]{1,8}$')
        && request.resource.data.keys().hasOnly(['owner', 'restaurant'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.restaurant is string
        && request.resource.data.restaurant.size() > 0
        && request.resource.data.restaurant.size() < 100
        // l'annuncio collegato esiste (dopo il batch), e' suo e usa questo CIN
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurant)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurant)).data.cin == cin;

      allow update: if false;

      // Il titolare quando elimina l'annuncio; l'amministratore con "Libera CIN"
      allow delete: if (signedIn()
          && resource.data.owner == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/restaurants/$(resource.data.restaurant)))
        || isAdmin();
    }

    // ---------- Segnalazioni (anche senza login) ----------
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['restaurant', 'name', 'reason', 'text', 'createdAt', 'lang', 'status'])
        && request.resource.data.keys().hasAll(['restaurant', 'reason', 'createdAt', 'status'])
        && request.resource.data.restaurant is string
        && request.resource.data.restaurant.size() > 0
        && request.resource.data.restaurant.size() < 200
        && request.resource.data.reason in ['fake', 'not_owner', 'payment', 'discount', 'wrong_data', 'other']
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 200))
        && (!('text' in request.resource.data)
            || (request.resource.data.text is string && request.resource.data.text.size() <= 500))
        && (!('lang' in request.resource.data)
            || (request.resource.data.lang is string && request.resource.data.lang.size() <= 5))
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'closedAt'])
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.get('resolution', '') is string
        && request.resource.data.get('resolution', '').size() <= 20;
    }

    // ---------- Contestazioni (titolare di un annuncio nascosto) ----------
    match /appeals/{appealId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['restaurant', 'owner', 'text', 'createdAt', 'status'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.restaurant is string
        && request.resource.data.restaurant.size() > 0
        && request.resource.data.restaurant.size() < 100
        && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurant)).data.owner == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'closedAt'])
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if isAdmin();
    }

    // ---------- Richiesta di liberare un CIN usato da un altro account ----------
    match /cinClaims/{claimId} {
      allow create: if emailVerified()
        && request.resource.data.keys().hasOnly(['cin', 'owner', 'email', 'text', 'createdAt', 'status'])
        && request.resource.data.owner == request.auth.uid
        && validCin(request.resource.data.cin)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        // il CIN e' davvero occupato, e non da chi lo rivendica
        && exists(cinPath(request.resource.data.cin))
        && get(cinPath(request.resource.data.cin)).data.owner != request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'closedAt'])
        && request.resource.data.status in ['open', 'closed'];
      // il titolare la elimina quando cancella l'account (contiene la sua email)
      allow delete: if isAdmin() || (signedIn() && resource.data.owner == request.auth.uid);
    }

    // ---------- Luoghi OpenStreetMap nascosti dopo moderazione ----------
    match /osmHidden/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['osmId', 'name', 'note', 'hiddenAt'])
        && request.resource.data.osmId is string
        && request.resource.data.osmId.matches('^(node|way|relation)/[0-9]+$')
        && docId == request.resource.data.osmId.replace('/', '_')
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.note is string
        && request.resource.data.note.size() > 0
        && request.resource.data.note.size() <= 1000
        && request.resource.data.hiddenAt == request.time;
      allow delete: if isAdmin();
    }

    // ---------- Accettazione di informativa e condizioni ----------
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['acceptedTermsAt', 'termsVersion'])
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() <= 20;
    }

    // ---------- Tutto il resto (incluso meta/): bloccato ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
